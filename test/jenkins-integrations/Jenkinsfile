// =========================================================
// Pipeline de migração MQ - dispara o Ansible do mq-docker-lab
//
// Este Jenkinsfile assume que o job está configurado como
// "Pipeline script from SCM", apontando para este repositório -
// assim o workspace do Jenkins já contém mq-docker-lab/ inteiro.
// =========================================================
pipeline {
    agent any

    parameters {
        choice(
            name: 'QM_FILTER',
            choices: ['PVCL01', 'PVCL02', 'PVCL03', 'PVCL04'],
            description: 'Qual Queue Manager migrar (ver group_vars/all.yml)'
        )
        string(
            name: 'OBJECT_FILTER',
            defaultValue: '',
            description: 'Tipos de objeto separados por vírgula (vazio = tudo). Ex: queue,channel'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Preparar Ansible') {
            steps {
                dir('mq-docker-lab/ansible-test') {
                    sh 'ansible-galaxy collection install community.docker'
                }
            }
        }

        stage('Conferir containers do lab') {
            steps {
                sh 'docker ps --format "table {{.Names}}\\t{{.Status}}"'
            }
        }

        stage('Migrar') {
            steps {
                dir('mq-docker-lab/ansible-test') {
                    script {
                        def objFilterArg = params.OBJECT_FILTER?.trim()
                            ? "-e \"object_filter=${params.OBJECT_FILTER}\""
                            : ''

                        sh """
                            ansible-playbook playbook.yml \
                              -e "qm_filter=${params.QM_FILTER}" \
                              ${objFilterArg} \
                              -v
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Migração de ${params.QM_FILTER} concluída (objetos: ${params.OBJECT_FILTER ?: 'todos'})."
        }
        failure {
            echo "Falha na migração de ${params.QM_FILTER}. Confira o log acima."
        }
    }
}
