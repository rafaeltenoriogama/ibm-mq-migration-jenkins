*******************************************************************
* create_objects_qm1.mqsc
* Popula o queue manager PBO11 (origem) com objetos de exemplo:
* Queues, Channels, Topics, Subscriptions, Listener e CHLAUTH (whitelist)
*******************************************************************

*--- QUEUES ---------------------------------------------------------
DEFINE QLOCAL('APP.REQUEST.QUEUE')     REPLACE DESCR('Fila de requisicoes da aplicacao')
DEFINE QLOCAL('APP.REPLY.QUEUE')       REPLACE DESCR('Fila de respostas da aplicacao')
DEFINE QLOCAL('APP.DEADLETTER.QUEUE')  REPLACE DESCR('Dead letter queue local')
DEFINE QLOCAL('ORDERS.IN.QUEUE')       REPLACE DESCR('Fila de entrada de pedidos')
DEFINE QLOCAL('ORDERS.OUT.QUEUE')      REPLACE DESCR('Fila de saida de pedidos')
DEFINE QALIAS('ORDERS.ALIAS')          TARGET('ORDERS.IN.QUEUE') REPLACE

*--- FILA DE TRANSMISSAO (para o canal SDR abaixo) -------------------
DEFINE QLOCAL('QM2.XMITQ') USAGE(XMITQ) REPLACE DESCR('Xmitq para PBO12')
DEFINE QREMOTE('REMOTE.TO.QM2') RNAME('REMOTE.QUEUE') RQMNAME('PBO12') XMITQ('QM2.XMITQ') REPLACE

*--- CHANNELS ----------------------------------------------------------
DEFINE CHANNEL('PBO11.SVRCONN') CHLTYPE(SVRCONN) REPLACE DESCR('Canal cliente-servidor')
DEFINE CHANNEL('TO.QM2')   CHLTYPE(SDR)   CONNAME('qm2(1414)') XMITQ('QM2.XMITQ') REPLACE
DEFINE CHANNEL('FROM.QM1') CHLTYPE(RCVR)  REPLACE

*--- LISTENER ------------------------------------------------------------
DEFINE LISTENER('PBO11.LISTENER') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('PBO11.LISTENER')

*--- TOPICS --------------------------------------------------------------
DEFINE TOPIC('APP.TOPIC')        TOPICSTR('app/orders') REPLACE
DEFINE TOPIC('APP.ALERTS.TOPIC') TOPICSTR('app/alerts') REPLACE

*--- SUBSCRIPTIONS -------------------------------------------------------
DEFINE SUB('APP.ORDERS.SUB') TOPICOBJ('APP.TOPIC') DEST('APP.REQUEST.QUEUE') REPLACE

*--- CHLAUTH (whitelist de IP para o canal cliente) -----------------------
* Bloqueia tudo por padrao e libera apenas a faixa da rede docker do lab.
* Ajuste o range conforme a rede/VLAN real em producao.
SET CHLAUTH('PBO11.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('172.16.0.0/12') USERSRC(CHANNEL) DESCR('Libera rede interna docker/CIDR corporativo') ACTION(ADD)

*--- PERMISSOES basicas para o usuario app nos objetos criados -----------
SET AUTHREC PROFILE('APP.*')        OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(ALL)
SET AUTHREC PROFILE('ORDERS.*')     OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(ALL)
SET AUTHREC PROFILE('APP.TOPIC')    OBJTYPE(TOPIC) PRINCIPAL('app') AUTHADD(ALL)

*--- Conferencia rapida ---------------------------------------------------
DISPLAY QLOCAL(*) WHERE(QUEUE NE SYSTEM.*)
DISPLAY CHANNEL(*) WHERE(CHANNEL NE SYSTEM.*)
DISPLAY TOPIC(*) WHERE(TOPIC NE SYSTEM.*)
DISPLAY SUB(*)
