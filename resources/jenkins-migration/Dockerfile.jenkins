FROM jenkins/jenkins:lts

USER root

# Instala o Docker CLI dentro do Jenkins para permitir "docker exec"
# nos containers qm1/qm2 através do socket montado (/var/run/docker.sock)
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -f docker \
    && usermod -aG docker jenkins

USER jenkins

# Plugins essenciais para o pipeline (Pipeline já vem no LTS, adicionamos
# apenas o que falta: aprovação/gate e Git, caso o Jenkinsfile venha de repo)
RUN jenkins-plugin-cli --plugins \
    workflow-aggregator \
    git \
    pipeline-stage-view \
    credentials-binding
