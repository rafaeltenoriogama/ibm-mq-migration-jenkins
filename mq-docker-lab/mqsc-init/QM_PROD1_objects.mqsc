* =========================================================
* Objetos iniciais do QM_PROD1 (simulação do ambiente antigo)
* =========================================================

* --- Filas ---
DEFINE QLOCAL('QM_PROD1.APP.REQUEST') DESCR('Fila de requisicoes da app') MAXDEPTH(5000) REPLACE
DEFINE QLOCAL('QM_PROD1.APP.REPLY')   DESCR('Fila de respostas da app')   MAXDEPTH(5000) REPLACE
DEFINE QLOCAL('QM_PROD1.DLQ')         DESCR('Dead letter queue')          MAXDEPTH(5000) REPLACE
DEFINE QALIAS('QM_PROD1.APP.ALIAS') TARGET('QM_PROD1.APP.REQUEST') REPLACE

* --- Canais ---
DEFINE CHANNEL('QM_PROD1.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE
DEFINE CHANNEL('QM_PROD1.TO.QM_PROD2') CHLTYPE(RCVR) DESCR('Canal receptor de QM_PROD2') REPLACE

* --- Topicos e subscricao ---
DEFINE TOPIC('QM_PROD1.PRICE.TOPIC') TOPICSTR('/qm_prod1/price') DESCR('Topico de precos') REPLACE
DEFINE SUB('QM_PROD1.PRICE.SUB') TOPICOBJ('QM_PROD1.PRICE.TOPIC') DEST('QM_PROD1.APP.REPLY') REPLACE

* --- Listener ---
DEFINE LISTENER('QM_PROD1.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('QM_PROD1.LISTENER.TCP')

* --- Whitelist de IP's (CHLAUTH) ---
SET CHLAUTH('QM_PROD1.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.10.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede interna 10.10.10.x')
SET CHLAUTH('QM_PROD1.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

* --- Autenticacao ---
DEFINE AUTHINFO('QM_PROD1.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('QM_PROD1.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
