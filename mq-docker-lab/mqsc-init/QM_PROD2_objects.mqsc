* =========================================================
* Objetos iniciais do QM_PROD2 (simulação do ambiente antigo)
* =========================================================

DEFINE QLOCAL('QM_PROD2.ORDERS.IN')  DESCR('Fila de entrada de pedidos') MAXDEPTH(8000) REPLACE
DEFINE QLOCAL('QM_PROD2.ORDERS.OUT') DESCR('Fila de saida de pedidos')   MAXDEPTH(8000) REPLACE
DEFINE QLOCAL('QM_PROD2.DLQ')        DESCR('Dead letter queue')          MAXDEPTH(5000) REPLACE

DEFINE CHANNEL('QM_PROD2.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE
DEFINE CHANNEL('QM_PROD2.TO.QM_PROD1') CHLTYPE(RCVR) DESCR('Canal receptor de QM_PROD1') REPLACE

DEFINE TOPIC('QM_PROD2.ORDERS.TOPIC') TOPICSTR('/qm_prod2/orders') DESCR('Topico de pedidos') REPLACE
DEFINE SUB('QM_PROD2.ORDERS.SUB') TOPICOBJ('QM_PROD2.ORDERS.TOPIC') DEST('QM_PROD2.ORDERS.OUT') REPLACE

DEFINE LISTENER('QM_PROD2.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('QM_PROD2.LISTENER.TCP')

SET CHLAUTH('QM_PROD2.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.10.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede interna 10.10.10.x')
SET CHLAUTH('QM_PROD2.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

DEFINE AUTHINFO('QM_PROD2.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('QM_PROD2.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
