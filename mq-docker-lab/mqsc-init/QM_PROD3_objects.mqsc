* =========================================================
* Objetos iniciais do QM_PROD3 (simulação do ambiente antigo - standalone)
* =========================================================

DEFINE QLOCAL('QM_PROD3.BATCH.IN')  DESCR('Fila de entrada de batch') MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('QM_PROD3.BATCH.OUT') DESCR('Fila de saida de batch')   MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('QM_PROD3.DLQ')       DESCR('Dead letter queue')        MAXDEPTH(5000) REPLACE

DEFINE CHANNEL('QM_PROD3.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE

DEFINE TOPIC('QM_PROD3.BATCH.TOPIC') TOPICSTR('/qm_prod3/batch') DESCR('Topico de batch') REPLACE
DEFINE SUB('QM_PROD3.BATCH.SUB') TOPICOBJ('QM_PROD3.BATCH.TOPIC') DEST('QM_PROD3.BATCH.OUT') REPLACE

DEFINE LISTENER('QM_PROD3.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('QM_PROD3.LISTENER.TCP')

SET CHLAUTH('QM_PROD3.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.20.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede do batch 10.10.20.x')
SET CHLAUTH('QM_PROD3.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

DEFINE AUTHINFO('QM_PROD3.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('QM_PROD3.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
