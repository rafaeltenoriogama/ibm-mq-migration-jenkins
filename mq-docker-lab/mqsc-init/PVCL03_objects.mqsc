* =========================================================
* Objetos iniciais do PVCL03 (simulação do ambiente antigo - standalone)
* =========================================================

DEFINE QLOCAL('PVCL03.BATCH.IN')  DESCR('Fila de entrada de batch') MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('PVCL03.BATCH.OUT') DESCR('Fila de saida de batch')   MAXDEPTH(10000) REPLACE
DEFINE QLOCAL('PVCL03.DLQ')       DESCR('Dead letter queue')        MAXDEPTH(5000) REPLACE

DEFINE CHANNEL('PVCL03.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE

DEFINE TOPIC('PVCL03.BATCH.TOPIC') TOPICSTR('/pvcl03/batch') DESCR('Topico de batch') REPLACE
DEFINE SUB('PVCL03.BATCH.SUB') TOPICOBJ('PVCL03.BATCH.TOPIC') DEST('PVCL03.BATCH.OUT') REPLACE

DEFINE LISTENER('PVCL03.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('PVCL03.LISTENER.TCP')

SET CHLAUTH('PVCL03.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.20.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede do batch 10.10.20.x')
SET CHLAUTH('PVCL03.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

DEFINE AUTHINFO('PVCL03.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('PVCL03.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
