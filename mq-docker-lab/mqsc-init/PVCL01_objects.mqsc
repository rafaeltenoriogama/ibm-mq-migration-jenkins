* =========================================================
* Objetos iniciais do PVCL01 (simulação do ambiente antigo)
* =========================================================

* --- Filas ---
DEFINE QLOCAL('PVCL01.APP.REQUEST') DESCR('Fila de requisicoes da app') MAXDEPTH(5000) REPLACE
DEFINE QLOCAL('PVCL01.APP.REPLY')   DESCR('Fila de respostas da app')   MAXDEPTH(5000) REPLACE
DEFINE QLOCAL('PVCL01.DLQ')         DESCR('Dead letter queue')          MAXDEPTH(5000) REPLACE
DEFINE QALIAS('PVCL01.APP.ALIAS') TARGET('PVCL01.APP.REQUEST') REPLACE

* --- Canais ---
DEFINE CHANNEL('PVCL01.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE
DEFINE CHANNEL('PVCL01.TO.PVCL02') CHLTYPE(RCVR) DESCR('Canal receptor de PVCL02') REPLACE

* --- Topicos e subscricao ---
DEFINE TOPIC('PVCL01.PRICE.TOPIC') TOPICSTR('/pvcl01/price') DESCR('Topico de precos') REPLACE
DEFINE SUB('PVCL01.PRICE.SUB') TOPICOBJ('PVCL01.PRICE.TOPIC') DEST('PVCL01.APP.REPLY') REPLACE

* --- Listener ---
DEFINE LISTENER('PVCL01.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('PVCL01.LISTENER.TCP')

* --- Whitelist de IP's (CHLAUTH) ---
SET CHLAUTH('PVCL01.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.10.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede interna 10.10.10.x')
SET CHLAUTH('PVCL01.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

* --- Autenticacao ---
DEFINE AUTHINFO('PVCL01.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('PVCL01.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
