* =========================================================
* Objetos iniciais do PVCL04 (simulação do ambiente antigo - standalone)
* =========================================================

DEFINE QLOCAL('PVCL04.NOTIF.IN')  DESCR('Fila de entrada de notificacoes') MAXDEPTH(6000) REPLACE
DEFINE QLOCAL('PVCL04.NOTIF.OUT') DESCR('Fila de saida de notificacoes')   MAXDEPTH(6000) REPLACE
DEFINE QLOCAL('PVCL04.DLQ')       DESCR('Dead letter queue')               MAXDEPTH(5000) REPLACE

DEFINE CHANNEL('PVCL04.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE

DEFINE TOPIC('PVCL04.NOTIF.TOPIC') TOPICSTR('/pvcl04/notif') DESCR('Topico de notificacoes') REPLACE
DEFINE SUB('PVCL04.NOTIF.SUB') TOPICOBJ('PVCL04.NOTIF.TOPIC') DEST('PVCL04.NOTIF.OUT') REPLACE

DEFINE LISTENER('PVCL04.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('PVCL04.LISTENER.TCP')

SET CHLAUTH('PVCL04.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.30.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede de notificacoes 10.10.30.x')
SET CHLAUTH('PVCL04.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

DEFINE AUTHINFO('PVCL04.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('PVCL04.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
