* =========================================================
* Objetos iniciais do PVCL02 (simulação do ambiente antigo)
* =========================================================

DEFINE QLOCAL('PVCL02.ORDERS.IN')  DESCR('Fila de entrada de pedidos') MAXDEPTH(8000) REPLACE
DEFINE QLOCAL('PVCL02.ORDERS.OUT') DESCR('Fila de saida de pedidos')   MAXDEPTH(8000) REPLACE
DEFINE QLOCAL('PVCL02.DLQ')        DESCR('Dead letter queue')          MAXDEPTH(5000) REPLACE

DEFINE CHANNEL('PVCL02.SVRCONN') CHLTYPE(SVRCONN) DESCR('Canal cliente-servidor') REPLACE
DEFINE CHANNEL('PVCL02.TO.PVCL01') CHLTYPE(RCVR) DESCR('Canal receptor de PVCL01') REPLACE

DEFINE TOPIC('PVCL02.ORDERS.TOPIC') TOPICSTR('/pvcl02/orders') DESCR('Topico de pedidos') REPLACE
DEFINE SUB('PVCL02.ORDERS.SUB') TOPICOBJ('PVCL02.ORDERS.TOPIC') DEST('PVCL02.ORDERS.OUT') REPLACE

DEFINE LISTENER('PVCL02.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
START LISTENER('PVCL02.LISTENER.TCP')

SET CHLAUTH('PVCL02.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('10.10.10.*') USERSRC(CHANNEL) ACTION(ADD) DESCR('Libera rede interna 10.10.10.x')
SET CHLAUTH('PVCL02.SVRCONN') TYPE(BLOCKUSER) USERLIST('*NOACCESS') ACTION(ADD) DESCR('Bloqueia mapeamento generico de usuario')

DEFINE AUTHINFO('PVCL02.AUTHINFO') AUTHTYPE(IDPWOS) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('PVCL02.AUTHINFO')
REFRESH SECURITY TYPE(CONNAUTH)
